{
  "manifest_version": "0.3",
  "name": "crustapi-mcp",
  "display_name": "CrustAPI Google + LinkedIn Data",
  "version": "0.3.4",
  "description": "Google Maps and public LinkedIn data for AI agents. Pay only for results.",
  "author": {
    "name": "CrustAPI",
    "url": "https://crustapi.com"
  },
  "homepage": "https://crustapi.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/CrustAPI/crustapi-mcp"
  },
  "license": "MIT",
  "server": {
    "type": "node",
    "entry_point": "server.mjs",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server.mjs"
      ],
      "env": {
        "CRUSTAPI_API_KEY": "${user_config.crustapi_api_key}"
      }
    }
  },
  "user_config": {
    "crustapi_api_key": {
      "type": "string",
      "title": "CrustAPI API Key",
      "description": "Try for free at crustapi.com. No credit card required.",
      "sensitive": true,
      "required": false
    }
  }
}
